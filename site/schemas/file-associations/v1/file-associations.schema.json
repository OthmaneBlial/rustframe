{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://othmaneblial.github.io/rustframe/schemas/file-associations/v1/file-associations.schema.json",
  "title": "RustFrame file associations schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "associations"],
  "properties": {
    "$schema": {
      "const": "https://othmaneblial.github.io/rustframe/schemas/file-associations/v1/file-associations.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "associations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extensions"],
        "properties": {
          "extensions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9+_-]{0,31}$"
            }
          },
          "mimeType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 127,
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          },
          "description": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "role": {
            "enum": ["editor", "viewer", "shell", "ql-generator", "none"],
            "default": "editor"
          }
        }
      }
    }
  }
}
